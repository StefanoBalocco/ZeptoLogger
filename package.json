{
  "name": "@stefanobalocco/zeptologger",
  "description": "A minimal log library",
  "version": "2.0.2",
  "type": "module",
  "types": "dist/ZeptoLogger.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ZeptoLogger.d.ts",
      "import": "./dist/ZeptoLogger.js"
    }
  },
  "files": [
    "dist/ZeptoLogger.js",
    "dist/ZeptoLogger.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanoBalocco/ZeptoLogger.git"
  },
  "keywords": [
    "log",
    "logger"
  ],
  "author": "Stefano Balocco <stefano.balocco@gmail.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/StefanoBalocco/ZeptoLogger/issues"
  },
  "homepage": "https://github.com/StefanoBalocco/ZeptoLogger",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsBuild all",
    "build:library": "tsBuild library",
    "build:tests": "tsBuild tests",
    "tests": "c8 --include=src --include=dist --exclude-after-remap --per-file --reporter=text --reporter=lcov ava 'tests/dist/*.test.js' --verbose"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@stefanobalocco/tsbuild": "^1",
    "ava": "^8",
    "c8": "^12"
  },
  "dependencies": {
    "safe-stable-stringify": "~2"
  }
}
